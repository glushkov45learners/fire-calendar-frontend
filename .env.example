# Base path of contract 3. Same origin as the app: nginx proxies /api in production, Vite proxies it to :8080 in dev.
VITE_API_URL=https://glushkov45learners.company/api/v1
# true = the dev server answers /api/v1 itself from src/shared/api/mocks (contract-3 shapes), no backend needed
VITE_USE_MOCKS=true

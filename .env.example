# Base path of contract 3. Keep it relative: the API must be on the app's origin (nginx/Caddy in production,
# the Vite proxy in dev). An absolute URL to another origin fails on CORS.
VITE_API_URL=/api/v1
# Dev only: where Vite forwards /api. Default http://localhost:8080.
API_PROXY_TARGET=https://glushkov45learners.company
# true = the dev server answers /api/v1 itself from src/shared/api/mocks (contract-3 shapes), no backend needed
VITE_USE_MOCKS=false

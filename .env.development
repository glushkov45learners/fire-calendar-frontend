# Same origin, as contract 3 requires: the app calls /api/v1 on the dev server, which proxies it (vite.config.ts).
# An absolute URL here (https://…/api/v1) makes the browser call another origin, and the backend sends no CORS headers.
VITE_API_URL=/api/v1
# Where the dev server forwards /api: the team's backend, or http://localhost:8080 for a local one.
API_PROXY_TARGET=https://glushkov45learners.company
# true = the dev server answers /api/v1 itself from src/shared/api/mocks instead of proxying
VITE_USE_MOCKS=false
